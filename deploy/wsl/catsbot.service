[Unit]
Description=Cat's Bot Discord bot and web dashboard
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=catsbot
Group=catsbot
WorkingDirectory=/opt/catsbot/app
ExecStart=/opt/catsbot/venv/bin/python -u /opt/catsbot/app/main.py
Restart=always
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGINT
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=API_HOST=127.0.0.1
UMask=0077
StateDirectory=catsbot
LogsDirectory=catsbot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/catsbot /var/log/catsbot

[Install]
WantedBy=multi-user.target
